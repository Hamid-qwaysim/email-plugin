{
  "name": "@arre/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit && echo 'worker type-checked (wrangler bundles on deploy)'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply arre_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply arre_db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@arre/shared": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
